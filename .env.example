# ---------------------------------------------------------------------------
# Template. Copy to .env.local and fill in real values:
#
#   cp .env.example .env.local
#
# .env.local is gitignored. THIS file is not — it is committed on purpose, so
# it must never contain a real key.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
#
# The project URL ROOT, no path. @supabase/ssr appends /rest/v1, /auth/v1 etc.
# itself; a trailing "/rest/v1/" here makes every request 404.
#
# The URL and anon key are safe to ship to the browser — Row Level Security is
# what actually gates access, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# DANGER: bypasses Row Level Security completely. Never prefix it NEXT_PUBLIC_,
# never import it into a client component, never log it. Only used by the
# maintenance helpers (cleanup_anonymous_users, prune_orphans) — leave blank if
# you are not running those.
SUPABASE_SERVICE_ROLE_KEY=

# UploadThing — dashboard > API Keys > V7 token. A single opaque token that
# encodes the app id and region.
UPLOADTHING_TOKEN=your-uploadthing-token

# Your UploadThing app id (the "appId" field inside the token above). Public:
# it only appears in the CDN hostname <appId>.ufs.sh that serves your files, and
# next.config.ts needs it at build time for image remotePatterns.
NEXT_PUBLIC_UPLOADTHING_APP_ID=your-app-id
