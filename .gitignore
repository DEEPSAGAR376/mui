# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the placeholder template is meant to be committed.
!.env.example

# supabase cli local state
/supabase/.branches
/supabase/.temp
/supabase/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent state. settings.json holds approved-command entries with an API key
# pasted inline, so this directory is deliberately never committed.
/.claude/
/.codegraph/
/.firecrawl/
/.cursor/